# Copy to .env and replace these example network settings.

# LAN address of the machine running revive-dns.
DNS_LISTEN_IP=192.0.2.53
# LAN subnet allowed to use this resolver.
DNS_ALLOW_CIDR=192.0.2.0/24
# Resolver for names without a rule. Leave blank to refuse those queries.
DNS_UPSTREAM=1.1.1.1

# Set to 1 for debug logging.
REVIVE_DNS_DEBUG=
